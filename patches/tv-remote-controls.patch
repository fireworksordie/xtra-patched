+    // Remote / D-pad support (Android TV). Called by MainActivity for every key event.
+    // Returns true when the key was consumed.
+    fun onRemoteKey(event: KeyEvent): Boolean {
+        if (_binding == null || !isMaximized) return false
+        when (event.keyCode) {
+            KeyEvent.KEYCODE_DPAD_UP,
+            KeyEvent.KEYCODE_DPAD_DOWN,
+            KeyEvent.KEYCODE_DPAD_LEFT,
+            KeyEvent.KEYCODE_DPAD_RIGHT,
+            KeyEvent.KEYCODE_DPAD_CENTER,
+            KeyEvent.KEYCODE_ENTER,
+            KeyEvent.KEYCODE_NUMPAD_ENTER -> {
+                if (!binding.playerControls.root.isVisible) {
+                    // Controls are hidden: reveal them and put focus on them, swallow the key
+                    if (event.action == KeyEvent.ACTION_DOWN && event.repeatCount == 0) {
+                        focusControlsWhenShown = true
+                        showController(force = true)
+                        updateProgress()
+                    }
+                    return true
+                } else if (event.action == KeyEvent.ACTION_DOWN) {
+                    // Controls are showing: keep them up while the user navigates
+                    showController(force = true)
+                }
+            }
+        }
+        return false
+    }
+
+    private fun focusControlsIfRequested() {
+        if (focusControlsWhenShown) {
