+                if (!playPause.requestFocus()) {
+                    root.requestFocus()
+                }
+            }
+        }
+    }
+
+    // The control buttons have transparent backgrounds, so a remote's focus would be invisible.
+    private fun applyFocusHighlight(parent: ViewGroup) {
+        for (i in 0 until parent.childCount) {
+            val child = parent.getChildAt(i)
+            if (child is ViewGroup) {
+                applyFocusHighlight(child)
+            }
+            if (child.isFocusable && child.isClickable) {
+                val background = child.background
+                if (background == null || (background is ColorDrawable && background.color == Color.TRANSPARENT)) {
+                    child.background = requireContext().getDrawable(R.drawable.player_control_focus)
+                }
+            }
+        }
+    }
